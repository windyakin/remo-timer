{
  "name": "backend",
  "version": "1.0.0",
  "description": "Nature Remote Timer Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "typeorm:js": "typeorm",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/database.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/database.ts",
    "migration:run:js": "npm run typeorm:js -- migration:run -d dist/config/database.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/database.ts",
    "migration:revert:js": "npm run typeorm:js -- migration:revert -d dist/config/database.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "connect-sqlite3": "^0.9.16",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "express-oauth2-jwt-bearer": "^1.7.3",
    "express-openid-connect": "^3.0.0",
    "express-session": "^1.19.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.7.0",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^6.0.0"
  }
}
